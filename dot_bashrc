# End of LM Studio CLI section
ai() {
  local prompt="$*"
  echo "🤖 $prompt"
  response=$(curl -s http://localhost:11434/api/generate \
    -d "{\"model\":\"llama3.1\",\"prompt\":\"$prompt\"}" \
    | jq -r '.response' | tee /tmp/ai_response.txt)

  echo ""
  echo "$response"
  echo ""

  # Ask if user wants to execute any shell command proposed
  if echo "$response" | grep -qE '^(\$|sudo|ls|cd|cp|mv|rm|apt|dnf|ssh|rsync|docker)'; then
    echo "⚙️  The response seems to contain commands. Run them? (y/n)"
    read -r ans
    if [[ "$ans" == "y" ]]; then
      echo "$response" | grep '^[[:alnum:]/~.$]' | while read -r cmd; do
        echo "👉 $cmd"
        eval "$cmd"
      done
    fi
  fi
}


